# Hugging Face — optional until dataset ingest (Phase 2); set if the hub requires auth
HF_TOKEN=

# Groq (Phase 4) — server only; never expose to a browser client
GROQ_API_KEY=
GROQ_MODEL=

# Deprecated aliases for Groq (still read if GROQ_* unset)
LLM_API_KEY=
LLM_MODEL=

# Optional: SQLite path (default: data/restaurants.sqlite)
# DATABASE_PATH=

# Optional: max rows after filters before Groq / projection (default: 30)
# RECOMMEND_CANDIDATE_CAP=

# Optional: Groq client (defaults are fine for most demos)
# GROQ_TIMEOUT_SECONDS=60
# GROQ_TEMPERATURE=0.25
# GROQ_JSON_MODE=true
